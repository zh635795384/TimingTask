<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.simatelex.admin.mappers.xfbps01.MailTablesMapper">

    <select id="selectTables" parameterType="String" resultType="java.util.LinkedHashMap">
        select ${ew.sqlSelect} from ${tableName}
        ${ew.customSqlSegment}
    </select>

    <select id="selectGroupBy" resultType="java.util.Map">
        select distinct ${groupBy} from ${tableName}
    </select>

    <update id="truncateTable" parameterType="String">
        truncate table ${tableName}
    </update>


</mapper>
