<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.simatelex.admin.mappers.xfstd01.MailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.simatelex.admin.pojo.Mail">
        <id column="id" property="id" />
        <!--property是映射到java bean中的,column是映射到数据库中的-->
        <result column="table_name" property="tableName"/>
        <result column="table_prefix" property="tablePrefix"/>
        <result column="table_suffix" property="tableSuffix"/>
        <result column="table_style" property="tableStyle"/>
        <result column="post_prefix" property="postPrefix"/>
        <result column="send_target" property="sendTarget"/>
        <result column="send_time" property="sendTime"/>
        <result column="is_rar" property="isRar"/>
        <result column="group_by" property="groupBy"/>
        <result column="file_name" property="fileName"/>
        <result column="div_excel" property="divExcel"/>
        <result column="out_column" property="outColumn"/>
        <result column="fonts" property="fonts"/>
        <result column="font_size" property="fontSize"/>
        <result column="insert_row" property="insertRow"/>
        <result column="path" property="path"/>
        <result column="subject" property="subject"/>
        <result column="sender" property="sender"/>
        <result column="receiver" property="receiver"/>
        <result column="cc" property="cc"/>
        <result column="bcc" property="bcc"/>
        <result column="attach" property="attach"/>
        <result column="body" property="body"/>
        <result column="contact" property="contact"/>
        <result column="is_export" property="isExport"/>
        <result column="is_del" property="isDel"/>
        <result column="create_user" property="createUser"/>
        <result column="create_date" property="createDate"/>
        <result column="update_date" property="updateDate"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, table_name, table_prefix, table_suffix, table_style, post_prefix, send_target, send_time, is_rar, group_by, file_name, div_excel, out_column, fonts, font_size, insert_row, path, subject, sender, receiver, cc, bcc, attach, body, contact, is_export, is_del, create_user, create_date, update_date
    </sql>

</mapper>
